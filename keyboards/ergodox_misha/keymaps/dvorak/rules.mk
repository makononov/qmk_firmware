# The Ergodox Misha has one RGB LED using the pins for the indicator LEDs
# No need for RGB Matrix or RGB underglow
RGB_MATRIX_ENABLE = no
RGBLIGHT_ENABLE = no
RGB_LIGHT = no
BACKLIGHT_ENABLE = no

# Essential features
CONSOLE_ENABLE = no        # Console for debug
COMMAND_ENABLE = no        # Commands for debug and configuration
AUDIO_ENABLE = no          # No audio support on Ergodox Misha

# Enable Caps Lock indicator via RGB LED
CAPS_LOCK_STATUS = yes